{%- comment -%}
  Maps A–Z to Unicode regional indicator symbols (flag emoji building blocks).

  Accepts:
    - letter: {String} Single letter A–Z
{%- endcomment -%}
{%- case letter -%}
  {%- when 'A' -%}🇦
  {%- when 'B' -%}🇧
  {%- when 'C' -%}🇨
  {%- when 'D' -%}🇩
  {%- when 'E' -%}🇪
  {%- when 'F' -%}🇫
  {%- when 'G' -%}🇬
  {%- when 'H' -%}🇭
  {%- when 'I' -%}🇮
  {%- when 'J' -%}🇯
  {%- when 'K' -%}🇰
  {%- when 'L' -%}🇱
  {%- when 'M' -%}🇲
  {%- when 'N' -%}🇳
  {%- when 'O' -%}🇴
  {%- when 'P' -%}🇵
  {%- when 'Q' -%}🇶
  {%- when 'R' -%}🇷
  {%- when 'S' -%}🇸
  {%- when 'T' -%}🇹
  {%- when 'U' -%}🇺
  {%- when 'V' -%}🇻
  {%- when 'W' -%}🇼
  {%- when 'X' -%}🇽
  {%- when 'Y' -%}🇾
  {%- when 'Z' -%}🇿
{%- endcase -%}
