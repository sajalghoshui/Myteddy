{% comment %}
  Variant-driven colour set pickers from custom.colour_set_number.

  Accepts:
  - variant: {Object}
  - product: {Object}
  - section_id: {String}
  - product_form_id: {String}
{% endcomment %}
{%- liquid
  if product_form_id == blank
    assign product_form_id = 'product-form-' | append: section_id
  endif

  assign colour_set_count = variant.metafields.custom.colour_set_number.value | default: 0 | plus: 0

  assign variant_colour_set = variant.metafields.custom.colour_set.value
  if variant_colour_set == blank
    assign variant_colour_set = product.metafields.custom.colour_set.value
  endif
  if variant_colour_set != blank
    assign colour_probe = variant_colour_set.colour_name.value | default: variant_colour_set.colour_name
    if colour_probe == blank
      assign variant_colour_set = variant_colour_set.first
    endif
  endif
-%}

{%- if colour_set_count > 0 and variant_colour_set != blank -%}
  <div class="variant-colour-set-pickers" data-variant-colour-set-pickers>
    {%- for set_index in (1..colour_set_count) -%}
      {%- assign set_label = 'Colour set ' | append: set_index -%}
      {%- assign property_name = 'properties[' | append: set_label | append: ']' -%}
      {%- assign picker_id = 'ColourSet-' | append: set_index | append: '-' | append: section_id -%}
      {%- assign error_id = picker_id | append: '-error' -%}
      {%- assign colour_set_error_message = 'Please choose a colour for ' | append: set_label -%}
      <div class="ear-text-field variant-colour-set-picker">
        {% render 'ear-text-colour-picker',
          colour_set: variant_colour_set,
          product_form_id: product_form_id,
          property_name: property_name,
          group_label: set_label,
          error_id: error_id,
          error_message: colour_set_error_message,
          start_visible: true,
          heading_text: set_label,
          picker_kind: 'colour-set'
        %}
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}
