{% doc %}
  Renders drawer menu items for a link list.

  @param {linklist} menu - Navigation menu to render.
  @param {string} [id_prefix] - Prefix for element IDs to keep them unique.

  @example
  {% render 'header-drawer-menu-items', menu: section.settings.menu %}
{% enddoc %}

{%- liquid
  assign drawer_id_prefix = id_prefix | default: ''
-%}
{%- for link in menu.links -%}
  <li>
    {%- if link.links != blank -%}
      <details id="Details-menu-drawer-{{ drawer_id_prefix }}menu-item-{{ forloop.index }}">
        <summary
          id="HeaderDrawer-{{ drawer_id_prefix }}{{ link.handle }}"
          class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
        >
          {{ link.title | escape }}
          <span class="svg-wrapper">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div
          id="link-{{ drawer_id_prefix }}{{ link.handle | escape }}"
          class="menu-drawer__submenu has-submenu gradient motion-reduce"
          tabindex="-1"
        >
          <div class="menu-drawer__inner-submenu">
            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
              <span class="svg-wrapper">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
              {{ link.title | escape }}
            </button>
            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
              {%- for childlink in link.links -%}
                <li>
                  {%- if childlink.links == blank -%}
                    <a
                      id="HeaderDrawer-{{ drawer_id_prefix }}{{ link.handle }}-{{ childlink.handle }}"
                      href="{{ childlink.url }}"
                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if childlink.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ childlink.title | escape }}
                    </a>
                  {%- else -%}
                    <details id="Details-menu-drawer-{{ drawer_id_prefix }}{{ link.handle }}-{{ childlink.handle }}">
                      <summary
                        id="HeaderDrawer-{{ drawer_id_prefix }}{{ link.handle }}-{{ childlink.handle }}"
                        class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                      >
                        {{ childlink.title | escape }}
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="childlink-{{ drawer_id_prefix }}{{ childlink.handle | escape }}"
                        class="menu-drawer__submenu menu-drawer__submenu--inline has-submenu gradient motion-reduce"
                      >
                        <div class="menu-drawer__inline-panel">
                          <ul
                            class="menu-drawer__menu list-menu"
                            role="list"
                            tabindex="-1"
                          >
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a
                                  id="HeaderDrawer-{{ drawer_id_prefix }}{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                  href="{{ grandchildlink.url }}"
                                  class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                  {% if grandchildlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{ grandchildlink.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </details>
    {%- else -%}
      <a
        id="HeaderDrawer-{{ drawer_id_prefix }}{{ link.handle }}"
        href="{{ link.url }}"
        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
        {% if link.current %}
          aria-current="page"
        {% endif %}
      >
        {{ link.title | escape }}
      </a>
    {%- endif -%}
  </li>
{%- endfor -%}
