<section class="testimonials-section">
  <div class="page-width-full">

    {% if section.settings.subheading != blank %}
      <div class="testimonials-subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="testimonials-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="testimonials-swiper swiper">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="testimonial-card">

              <div class="testimonial-quote">“</div>

              <div class="testimonial-content">
                {% if block.settings.text != blank %}
                  <div class="testimonial-text">
                    {{ block.settings.text  | strip_html | truncate: 200 }}
                  </div>
                {% endif %}

                {% if block.settings.name != blank %}
                  <div class="testimonial-name">
                    {{ block.settings.name }}
                  </div>
                {% endif %}

                {% if block.settings.date != blank %}
                  <div class="testimonial-date">
                    {{ block.settings.date }}
                  </div>
                {% endif %}
              </div>

            </div>
          </div>
        {% endfor %}

      </div>

      <div class="swiper-pagination"></div>
    </div>

  </div>
</section>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const testimonialSliders = document.querySelectorAll('.testimonials-swiper');

    testimonialSliders.forEach(function (slider) {
      new Swiper(slider, {
        slidesPerView: 1.2,
        spaceBetween: 0,
        speed: 600,

        pagination: false,

        breakpoints: {
          768: {
            slidesPerView: 3,
            spaceBetween: 0
          },

          1024: {
            slidesPerView: 4,
            spaceBetween: 0
          }
        }
      });
    });
  });
</script>

<style>
  .testimonials-section {
    position: relative;
    padding: 55px 50px 60px 50px;
    overflow: hidden;
    background: #fff;
  }
.testimonials-swiper .swiper-slide{
    padding:20px 15px;
    box-sizing:border-box;
    height:auto;
}
  .testimonials-section .page-width-full {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .testimonials-subheading {
    text-align: center;
    color: #747d87;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .testimonials-heading {
    text-align: center;
    color: #2ab9c1;
    font-size: 36px;
    line-height: 1.15;
    margin: 0 0 55px;
    font-weight: 700;
  }

  

  .testimonial-card {
    position: relative;
    min-height: 180px;
    padding: 25px 21px 20px;
    background: #fff;
    border-radius: 15px;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.10);
    box-sizing: border-box;
        height: 100%;
  }

  .testimonial-quote {
    position: absolute;
    top: 0;
    left: 12px;
    z-index: 0;
    font-family: Georgia, serif;
    font-size: 140px;
    line-height: 1;
    font-weight: bold;
    color: #f0f0f0;
    pointer-events: none;
  }

  .testimonial-content {
    position: relative;
    z-index: 1;
  }

  .testimonial-text {
    color: #000;
    font-size: 14px;
    line-height: 1.55;
    min-height: 76px;
    margin-bottom: 14px;
  }

  .testimonial-name {
    color: #27b9c1;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 700;
  }

  .testimonial-date {
    color: #27b9c1;
    font-size: 10px;
    line-height: 1.3;
    margin-top: 2px;
  }

  .testimonials-swiper .swiper-pagination {
    position: relative;
    margin-top: 30px;
  }

  .testimonials-swiper .swiper-pagination-bullet {
    width: 7px;
    height: 7px;
    opacity: .35;
  }

  .testimonials-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  @media screen and (max-width: 767px) {
    .testimonials-section {
      padding: 40px 0 45px;
    }

    .testimonials-heading {
      font-size: 30px;
      margin-bottom: 20px;
    }

    .testimonial-card {
      min-height: 195px;
    }

    .testimonial-text {
      min-height: auto;
    }
    .testimonials-swiper .swiper-slide {
    padding: 20px 10px;
    box-sizing: border-box;
    height: auto;
}
.testimonials-section .page-width-full {
  
    padding: 0 0;
}
  }
</style>

{% schema %}
