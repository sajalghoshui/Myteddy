<section
  id="custom-swiper-{{ section.id }}"
  class="custom-swiper-section"
>
  <div class="custom-swiper swiper">
    <div class="swiper-wrapper">

      {% for block in section.blocks %}
        <div
          class="swiper-slide custom-swiper-slide"
          style="
            background-color: {{ block.settings.background_color }};
            color: {{ block.settings.text_color }};
          "
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
  <div class="custom-swiper-image">

    <picture>
      {% if block.settings.mobile_image != blank %}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ block.settings.mobile_image | image_url: width: 400 }} 400w,
            {{ block.settings.mobile_image | image_url: width: 600 }} 600w,
            {{ block.settings.mobile_image | image_url: width: 800 }} 800w
          "
          sizes="100vw"
        >
      {% endif %}

     {{
  block.settings.image
  | image_url: width: 2000
  | image_tag:
    loading: 'lazy',
    widths: '400, 600, 800, 1800, 2000',
    sizes: '(min-width: 750px) 55vw, 100vw',
    alt: block.settings.image.alt
}}
    </picture>

  </div>
{% endif %}
          <div class="custom-swiper-content">



            <div class="custom-swiper-text">

              {% if block.settings.heading != blank %}
                <h2>
                  {{ block.settings.heading }}
                </h2>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="custom-swiper-description">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.button_text != blank %}
                <a
                  href="{{ block.settings.button_link }}"
                  class="custom-swiper-button-header btn"
                >
                  {{ block.settings.button_text }}
                </a>
              {% endif %}

            </div>

          </div>

        </div>
      {% endfor %}

    </div>

    {% if section.settings.show_arrows %}
      <div class="swiper-button-prev"><svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
  <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
</path></svg></div>
      <div class="swiper-button-next"><svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
  <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
</path></svg></div>
    {% endif %}

    {% if section.settings.show_pagination %}
      <div class="swiper-pagination"></div>
    {% endif %}
  </div>
</section>

<style>
  #custom-swiper-{{ section.id }} {
    width: 100%;
  }

  #custom-swiper-{{ section.id }} .custom-swiper {
    width: 100%;
    overflow: hidden;
  }

  #custom-swiper-{{ section.id }} .custom-swiper-slide {
    min-height: {{ section.settings.desktop_height }}px;
    position: relative;
    overflow: hidden;
  }

  #custom-swiper-{{ section.id }} .custom-swiper-content {
    width: 100%;
    max-width: 1400px;
    min-height: inherit;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 50px 100px;
    gap: 50px;
    box-sizing: border-box;
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    color:#fff;
  }

  #custom-swiper-{{ section.id }} .custom-swiper-image {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
#custom-swiper-{{ section.id }} .custom-swiper-image picture{
width:100%;
}
  #custom-swiper-{{ section.id }} .custom-swiper-image img {
       width: 100%;
    max-width: 100%;
    height: 100vh;
    display: block;
    object-fit: cover;
    object-position: top;
  }

  #custom-swiper-{{ section.id }} .custom-swiper-text {
    width: 100%;
    max-width: 500px;
    color:#b564a7;
  }

  #custom-swiper-{{ section.id }} .custom-swiper-text h2 {
    margin: 0 0 25px;
    font-size: clamp(32px, 4vw, 64px);
    line-height: 1.1;
    color: inherit;
  }
    @media screen and (min-width: 1600px) {
   #custom-swiper-{{ section.id }} .custom-swiper-text {
    width: 100%;
    max-width: 650px;
    color:#b564a7;
  }
}
  #custom-swiper-{{ section.id }} .custom-swiper-description {
    margin-bottom: 30px;
    font-size: 18px;
    line-height: 1.6;
  }

  #custom-swiper-{{ section.id }} .custom-swiper-button-header {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 14px 30px;

    background: #2dbfc5;
    color: #fff;

    text-decoration: none;
    border-radius: 30px;

    font-size: 26px;
    line-height: 1;

    transition: all 0.3s ease;
  }

  #custom-swiper-{{ section.id }} .custom-swiper-button:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  #custom-swiper-{{ section.id }} .swiper-button-prev,
  #custom-swiper-{{ section.id }} .swiper-button-next {
    color: currentColor;
  }

  #custom-swiper-{{ section.id }} .swiper-pagination-bullet {
    background: currentColor;
  }

  @media screen and (max-width: 749px) {
#custom-swiper-{{ section.id }} .custom-swiper-image img{
  height:60vh;
}
    #custom-swiper-{{ section.id }} .custom-swiper-slide {
      min-height: auto;
    }

    #custom-swiper-{{ section.id }} .custom-swiper-content {
      flex-direction: column;
      padding: 0;
      gap: 20px;
      text-align: center;
      top: auto;
      bottom:10px;
    }

    #custom-swiper-{{ section.id }} .custom-swiper-image {
      width: 100%;
      order: 1;
    }

    #custom-swiper-{{ section.id }} .custom-swiper-text {
      width: 100%;
      order: 2;
    }

    #custom-swiper-{{ section.id }} .custom-swiper-text h2 {
      font-size: 34px;
      display:none;
    }

    #custom-swiper-{{ section.id }} .custom-swiper-description {
      font-size: 16px;
      display:none;
    }

    #custom-swiper-{{ section.id }} .swiper-button-prev,
    #custom-swiper-{{ section.id }} .swiper-button-next {
      display: none;
    }
  }
</style>


<script>
  document.addEventListener('DOMContentLoaded', function () {

    const slider = document.querySelector(
      '#custom-swiper-{{ section.id }} .custom-swiper'
    );

    if (!slider) return;

    new Swiper(slider, {
      slidesPerView: 1,
      spaceBetween: 0,

      loop: {{ section.settings.loop }},

      {% if section.settings.autoplay %}
      autoplay: {
        delay: {{ section.settings.autoplay_speed }},
        disableOnInteraction: false
      },
      {% endif %}

      {% if section.settings.show_pagination %}
      pagination: {
        el: '#custom-swiper-{{ section.id }} .swiper-pagination',
        clickable: true
      },
      {% endif %}

      {% if section.settings.show_arrows %}
      navigation: {
        nextEl: '#custom-swiper-{{ section.id }} .swiper-button-next',
        prevEl: '#custom-swiper-{{ section.id }} .swiper-button-prev'
      },
      {% endif %}

      speed: 600
    });

  });
</script>

{% schema %}
{
  "name": "Header Banner Home",
  "tag": "section",
  "class": "custom-swiper-slideshow",
  "settings": [
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 300,
      "max": 900,
      "step": 10,
      "default": 600,
      "unit": "px"
    },
   
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "default": 5000,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        },
        {
        "type": "image_picker",
        "id": "mobile_image",
        "label": "Mobile image",
        "info": "Recommended for screens below 750px."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A Wonderful, Personal Touch"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>A personal gift made especially for someone special.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Check Out"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#B15DA5"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header Banner Home",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}