  <span class="svg-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 18 18" class="header__nav-icon icon icon-cart"><path id="bag" d="M13.276 4.728a.34.34 0 0 0-.34-.316h-1.599c0-.024.005-.047.005-.072A3.344 3.344 0 0 0 8.002 1 3.337 3.337 0 0 0 4.67 4.34c0 .025.005.048.005.072h-1.6a.34.34 0 0 0-.34.316l-.734 10.198a.34.34 0 0 0 .34.364h11.33a.341.341 0 0 0 .34-.364l-.736-10.198h.001ZM5.351 4.34c0-1.467 1.19-2.66 2.652-2.66a2.666 2.666 0 0 1 2.66 2.66v.072h-5.31V4.34H5.35ZM2.708 14.61l.685-9.519h9.228l.686 9.518h-10.6Z" fill="currentColor"></path></svg></span>
