<style>
  .shop-category-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .shop-category-{{ section.id }} .shop-category__header {
    text-align: center;
    margin-bottom: 30px;
  }

  .shop-category-{{ section.id }} .shop-category__heading {
    margin: 0 0 8px;
  }

  .shop-category-{{ section.id }} .shop-category__subheading {
    margin: 0 auto;
    max-width: 700px;
  }

  .shop-category-{{ section.id }} .swiper {
    width: 100%;
    overflow: hidden;
    padding:0px 0 50px;
  }

  .shop-category-{{ section.id }} .swiper-wrapper {
    align-items: stretch;
    padding:0 0;
  }

  .shop-category-{{ section.id }} .swiper-slide {
    height: auto;
    padding:15px 10px;
    box-sizing:border-box;
  }

  .shop-category-{{ section.id }} .collection-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.10);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .shop-category-{{ section.id }} .collection-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.14);
  }

  .shop-category-{{ section.id }} .collection-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
  }

  .shop-category-{{ section.id }} .collection-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    object-position: top;
  }

  .shop-category-{{ section.id }} .collection-card:hover .collection-card__image img {
    transform: scale(1.04);
  }

  .shop-category-{{ section.id }} .collection-card__content {
    padding: 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .shop-category-{{ section.id }} .collection-card__title {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
    color:#757d85;
  }

  .shop-category-{{ section.id }} .collection-card__text {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.4;
    color:#000;
  }

  .shop-category-{{ section.id }} .swiper-button-prev,
  .shop-category-{{ section.id }} .swiper-button-next {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: {{ section.settings.navigation_background }};
  }

  .shop-category-{{ section.id }} .swiper-button-prev::after,
  .shop-category-{{ section.id }} .swiper-button-next::after {
    font-size: 16px;
    font-weight: 700;
  }

  .shop-category-{{ section.id }} .swiper-pagination {
    position: relative;
    margin-top: 25px;
  }

  .shop-category-{{ section.id }} .swiper-pagination-bullet-active {
    background: {{ section.settings.pagination_color }};
  }
  .shop-category__slider-wrapper{
    padding:0 50px;
    }
    .collection__title.title-wrapper{
        text-align:center;
    }
  @media screen and (max-width: 749px) {
    .shop-category-{{ section.id }} .shop-category__header {
      margin-bottom: 20px;
    }

    .shop-category-{{ section.id }} .collection-card__content {
      padding: 14px;
    }

    .shop-category-{{ section.id }} .collection-card__title {
      font-size: 14px;
      min-height:40px;
    }

    .shop-category-{{ section.id }} .swiper-button-prev,
    .shop-category-{{ section.id }} .swiper-button-next {
      width: 34px;
      height: 34px;
    }

    .shop-category-{{ section.id }} .swiper-button-prev::after,
    .shop-category-{{ section.id }} .swiper-button-next::after {
      font-size: 13px;
    }
    .shop-category__slider-wrapper {
    padding: 0 0;
}
 .shop-category-{{ section.id }} .swiper-slide {
    height: auto;
    padding:15px 5px;
    box-sizing:border-box;
  }
  .collection-card__content .btn{
            font-size: 14px;
        border: 0;
        padding: 7px 0;
  }
  .shop-category-{{ section.id }} .swiper {
   
    padding:0px 0 10px;
  }
 .shop-category-{{ section.id }} .swiper-button-prev,  .shop-category-{{ section.id }} .swiper-button-next{
  display:none !important;
  }
  }
</style>


<section class="shop-category shop-category-{{ section.id }} color-{{ section.settings.color_scheme }} isolate gradient">

  <div class="page-width-full">
{% if section.settings.heading != blank or section.settings.subheading != blank %}
     <div class="collection__title title-wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="title inline-richtext h1 {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
         {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank
        or section.settings.show_description
        and section.settings.collection.description != empty
      -%}
        <div class="collection__description {{ section.settings.description_style }} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}
    </div>
  {% endif %}



    <div class="shop-category__slider-wrapper">

      <div
        class="swiper shop-category-swiper-{{ section.id }}"
        data-section-id="{{ section.id }}"
      >

        <div class="swiper-wrapper">

          {% for block in section.blocks %}

            {% assign collection = block.settings.collection %}

            {% if collection != blank %}

              <div
                class="swiper-slide"
                {{ block.shopify_attributes }}
              >

                <a
                  href="{{ collection.url }}"
                  class="collection-card"
                >

                  <div class="collection-card__image">

                    {% if block.settings.image != blank %}

                      {{
                        block.settings.image
                        | image_url: width: 1000
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 800, 1000',
                          sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 90vw',
                          alt: collection.title
                      }}

                    {% elsif collection.featured_image != blank %}

                      {{
                        collection.featured_image
                        | image_url: width: 1000
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 800, 1000',
                          sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 90vw',
                          alt: collection.title
                      }}

                    {% else %}

                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}

                    {% endif %}

                  </div>


                  <div class="collection-card__content">

                    <h3 class="collection-card__title">
                      {{ collection.title }}
                    </h3>

                    {% if block.settings.show_description and collection.description != blank %}
                      <div class="collection-card__text small-hide">
                        {{ collection.description | strip_html | truncate: 80 }}
                      </div>
                    {% endif %}
                    <button class="btn">Explore the Collection</button>
                  </div>

                </a>

              </div>

            {% endif %}

          {% endfor %}

        </div>


        {% if section.settings.show_navigation %}
          <div class="swiper-button-prev"><svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
  <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
</path></svg></div>
          <div class="swiper-button-next"><svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
  <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
</path></svg></div>
        {% endif %}


        {% if section.settings.show_pagination %}
          <div class="swiper-pagination"></div>
        {% endif %}

      </div>

    </div>

  </div>

</section>


<script>
(function () {

  const sectionId = '{{ section.id }}';
  const sliderSelector = '.shop-category-swiper-' + sectionId;

  function initCollectionSwiper() {

    const slider = document.querySelector(sliderSelector);

    if (!slider) {
      return;
    }

    /*
     * Wait until Swiper JS is available
     */
    if (typeof Swiper === 'undefined') {
      setTimeout(initCollectionSwiper, 100);
      return;
    }

    /*
     * Destroy existing Swiper instance
     * This is important for Shopify Theme Editor
     */
    if (slider.swiper) {
      slider.swiper.destroy(true, true);
    }

    const options = {

      slidesPerView: 2.2,

      spaceBetween: 0,

      speed: {{ section.settings.speed | default: 600 }},

      grabCursor: true,

      watchOverflow: true,

      breakpoints: {

        750: {
          slidesPerView: {{ section.settings.slides_tablet | default: 2 }},
          spaceBetween: 0
        },

        990: {
          slidesPerView: {{ section.settings.slides_desktop | default: 3 }},
          spaceBetween: 0
        }

      }

    };


    {% if section.settings.loop %}
      options.loop = true;
    {% endif %}


    {% if section.settings.autoplay %}
      options.autoplay = {
        delay: {{ section.settings.autoplay_delay | default: 4000 }},
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      };
    {% endif %}


    {% if section.settings.show_navigation %}

      options.navigation = {
        nextEl: slider.querySelector('.swiper-button-next'),
        prevEl: slider.querySelector('.swiper-button-prev')
      };

    {% endif %}


    {% if section.settings.show_pagination %}

      options.pagination = {
        el: slider.querySelector('.swiper-pagination'),
        clickable: true
      };

    {% endif %}


    /*
     * Initialize Swiper
     */
    new Swiper(slider, options);

  }


  /*
   * Normal storefront
   */
  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initCollectionSwiper
    );

  } else {

    initCollectionSwiper();

  }


  /*
   * Shopify Theme Editor
   */
  document.addEventListener(
    'shopify:section:load',
    function (event) {

      if (
        event.detail &&
        event.detail.sectionId === sectionId
      ) {
        setTimeout(initCollectionSwiper, 50);
      }

    }
  );


  /*
   * Shopify Theme Editor section reorder
   */
  document.addEventListener(
    'shopify:section:reorder',
    function (event) {

      if (
        event.detail &&
        event.detail.sectionId === sectionId
      ) {
        setTimeout(initCollectionSwiper, 50);
      }

    }
  );


  /*
   * Shopify Theme Editor section select
   */
  document.addEventListener(
    'shopify:section:select',
    function (event) {

      if (
        event.detail &&
        event.detail.sectionId === sectionId
      ) {
        setTimeout(initCollectionSwiper, 50);
      }

    }
  );

})();
</script>


{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "section-shop-by-category",
  "settings": [
     {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },

    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Our online gift shop has a massive range of custom animal plush toys, and personalised toys</p>"
    },

    {
      "type": "header",
      "content": "Slider settings"
    },

    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides on desktop",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "default": 3
    },

    {
      "type": "range",
      "id": "slides_tablet",
      "label": "Slides on tablet",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "default": 2
    },

    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Slides on mobile",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.1
    },

    {
      "type": "range",
      "id": "space_desktop",
      "label": "Desktop gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "space_tablet",
      "label": "Tablet gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "space_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "speed",
      "label": "Transition speed",
      "min": 200,
      "max": 1500,
      "step": 100,
      "unit": "ms",
      "default": 600
    },

    {
      "type": "checkbox",
      "id": "loop",
      "label": "Enable loop",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },

    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },

    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination",
      "default": false
    },

    {
      "type": "header",
      "content": "Card settings"
    },

    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },

    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },

    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }

  ],

  "blocks": [

    {
      "type": "collection",
      "name": "Collection card",
      "settings": [

        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },

        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Optional. If empty, collection featured image will be used."
        },

        {
          "type": "checkbox",
          "id": "show_description",
          "label": "Show description",
          "default": true
        }

      ]
    }

  ],

  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]

}
{% endschema %}