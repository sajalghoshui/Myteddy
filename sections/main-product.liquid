</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  let firstEarText = '';
  let secondEarText = '';
  let earTextColour = '';
  let sharedEarColourAndFontRevealed = false;
  const EAR_TEXT_COLOUR_PROPERTY = 'properties[Ear text colour]';
  const lineItemPropertyValues = new Map();
  const lineItemPropertyExplicitClears = new Set();
  const variantColourSetValues = new Map();
  const sectionId = '{{ section.id }}';
  const mainProductRoot = document.getElementById('MainProduct-{{ section.id }}');

  function rememberLineItemPropertyValue(key, value, fromUserInput) {
    if (!key) return;
    if (fromUserInput) {
      if (value === '') {
        lineItemPropertyExplicitClears.add(key);
      } else {
        lineItemPropertyExplicitClears.delete(key);
      }
      lineItemPropertyValues.set(key, value);
      return;
    }
    if (value === '') {
      const saved = lineItemPropertyValues.get(key);
      if (saved != null && saved !== '' && !lineItemPropertyExplicitClears.has(key)) {
        return;
      }
    }
    lineItemPropertyValues.set(key, value);
  }

  function saveLineItemPropertyFields() {
    document.querySelectorAll('[data-line-item-property]').forEach(function (input) {
      const key = input.getAttribute('data-line-item-property');
      rememberLineItemPropertyValue(key, input.value, false);
    });
  }

  function restoreTextInputValue(input, saved) {
    if (!input || saved == null || saved === '') return;
    if (document.activeElement === input) return;
    if (input.value === saved) return;
    if (input.value.trim() !== '' && !lineItemPropertyExplicitClears.has(
      input.getAttribute('data-line-item-property')
    )) {
      return;
    }
    input.value = saved;
  }

  function restoreLineItemPropertyFields() {
    document.querySelectorAll('[data-line-item-property]').forEach(function (input) {
      const key = input.getAttribute('data-line-item-property');
      if (!key || !lineItemPropertyValues.has(key)) return;
      restoreTextInputValue(input, lineItemPropertyValues.get(key));
    });
  }

  const EMBROIDERY_COLOUR_CHOICE_MAX = 3;

  function getEmbroideryColourChoiceOrder(picker) {
    if (!picker) return [];
    return (picker.dataset.colourOrder || '')
      .split('\u0001')
      .map(function (name) {
        return name.trim();
      })
      .filter(Boolean);
  }

  function setEmbroideryColourChoiceOrder(picker, order) {
    if (!picker) return;
    picker.dataset.colourOrder = order.join('\u0001');
  }

  function syncEmbroideryColourChoiceHiddenInput(picker) {
    if (!picker) return;
    const hidden = picker.querySelector('[data-embroidery-colour-choice-value]');
    if (!hidden) return;
    const order = getEmbroideryColourChoiceOrder(picker);
    if (!order.length) {
      hidden.value = '';
      hidden.disabled = true;
      return;
    }
    hidden.value = order.join(', ');
    hidden.disabled = false;
  }

  function readEmbroideryColourChoiceSavedValue(picker) {
    const hidden = picker.querySelector('[data-embroidery-colour-choice-value]');
    if (hidden && !hidden.disabled && hidden.value.trim()) {
      return hidden.value.trim();
    }
    const order = getEmbroideryColourChoiceOrder(picker);
    return order.length ? order.join(', ') : '';
  }

  function applyEmbroideryColourChoiceSavedValue(picker, saved) {
    const names = saved
      ? saved.split(', ').map(function (name) {
          return name.trim();
        }).filter(Boolean)
      : [];
    setEmbroideryColourChoiceOrder(picker, names);
    picker.querySelectorAll('[data-embroidery-text-colour-checkbox]').forEach(function (checkbox) {
      checkbox.checked = names.indexOf(checkbox.value) !== -1;
    });
    syncEmbroideryColourChoiceHiddenInput(picker);
    syncEmbroideryColourSwatchAvailability(picker);
  }

  function syncEmbroideryColourSwatchAvailability(picker) {
    if (!picker) return;
    const order = getEmbroideryColourChoiceOrder(picker);
    const atMax = order.length >= EMBROIDERY_COLOUR_CHOICE_MAX;
    picker.querySelectorAll('[data-embroidery-text-colour-checkbox]').forEach(function (checkbox) {
      const label = checkbox.closest('.ear-colour-swatch');
      const disable = atMax && !checkbox.checked;
      checkbox.setAttribute('aria-disabled', disable ? 'true' : 'false');
      if (label) {
        label.classList.toggle('ear-colour-swatch--unavailable', disable);
      }
    });
  }

  function saveVariantColourSetValues() {
    document
      .querySelectorAll(
        '[data-variant-colour-set-picker][data-property-name], [data-embroidery-text-colour-picker][data-property-name]'
      )
      .forEach(function (picker) {
        const propertyName = picker.getAttribute('data-property-name');
        if (!propertyName) return;
        if (picker.hasAttribute('data-embroidery-text-colour-picker')) {
          variantColourSetValues.set(
            propertyName,
            readEmbroideryColourChoiceSavedValue(picker)
          );
          return;
        }
        const checked = picker.querySelector(
          'input[name="' + propertyName + '"]:checked'
        );
        variantColourSetValues.set(propertyName, checked ? checked.value : '');
      });
  }

  function restoreVariantColourSetValues() {
    document
      .querySelectorAll(
        '[data-variant-colour-set-picker][data-property-name], [data-embroidery-text-colour-picker][data-property-name]'
      )
      .forEach(function (picker) {
        const propertyName = picker.getAttribute('data-property-name');
        if (!propertyName || !variantColourSetValues.has(propertyName)) return;
        const saved = variantColourSetValues.get(propertyName);
        if (picker.hasAttribute('data-embroidery-text-colour-picker')) {
          if (!saved) return;
          const current = readEmbroideryColourChoiceSavedValue(picker);
          if (current === saved) return;
          applyEmbroideryColourChoiceSavedValue(picker, saved);
          return;
        }
        if (!saved) return;
        const hasChecked = picker.querySelector(
          'input[name="' + propertyName + '"]:checked'
        );
        if (hasChecked && hasChecked.value === saved) return;
        if (hasChecked && document.activeElement === hasChecked) return;
        picker.querySelectorAll('input[name="' + propertyName + '"]').forEach(function (radio) {
          radio.checked = radio.value === saved;
        });
      });
  }

  function showVariantColourSetError(picker) {
    if (!picker) return;
    picker.classList.add('ear-text-field__colour--invalid');
    const errorEl = picker.querySelector('.ear-text-field__colour-error');
    if (errorEl) errorEl.classList.remove('hidden');
    const firstRadio = picker.querySelector('input[type="radio"]');
    if (firstRadio) {
      firstRadio.setAttribute('aria-invalid', 'true');
      if (errorEl) firstRadio.setAttribute('aria-describedby', errorEl.id);
    }
  }

  function clearVariantColourSetError(picker) {
    if (!picker) return;
    picker.classList.remove('ear-text-field__colour--invalid');
    const errorEl = picker.querySelector('.ear-text-field__colour-error');
    if (errorEl) errorEl.classList.add('hidden');
    picker.querySelectorAll('input[type="radio"]').forEach(function (radio) {
      radio.setAttribute('aria-invalid', 'false');
      radio.removeAttribute('aria-describedby');
    });
  }

  function embroideryTextBlockHasContent(block) {
    if (!block) return false;
    return Array.prototype.some.call(
      block.querySelectorAll('[data-embroidery-text-input]'),
      function (input) {
        return Boolean(input.value.trim());
      }
    );
  }

  function showEmbroideryTextColourError(block) {
    const picker = block.querySelector(
      '[data-embroidery-text-colour-picker][data-has-colours="true"]'
    );
    if (!picker) return;

    block.classList.add('ear-text-field--invalid');
    picker.classList.add('ear-text-field__colour--invalid');

    const errorEl = picker.querySelector('.ear-text-field__colour-error');
    if (errorEl) errorEl.classList.remove('hidden');

    const firstControl = picker.querySelector('[data-embroidery-text-colour-checkbox]');
    if (firstControl) {
      firstControl.setAttribute('aria-invalid', 'true');
      if (errorEl) firstControl.setAttribute('aria-describedby', errorEl.id);
    }
  }

  function clearEmbroideryTextColourError(block) {
    const picker = block.querySelector('[data-embroidery-text-colour-picker]');
    if (!picker) return;

    block.classList.remove('ear-text-field--invalid');
    picker.classList.remove('ear-text-field__colour--invalid');

    const errorEl = picker.querySelector('.ear-text-field__colour-error');
    if (errorEl) errorEl.classList.add('hidden');

    picker.querySelectorAll('[data-embroidery-text-colour-checkbox]').forEach(function (checkbox) {
      checkbox.setAttribute('aria-invalid', 'false');
      checkbox.removeAttribute('aria-describedby');
    });
  }

  function clearEmbroideryColourSelection(picker, propertyName) {
    if (!picker) return;
    picker.querySelectorAll('[data-embroidery-text-colour-checkbox]').forEach(function (checkbox) {
      checkbox.checked = false;
    });
    setEmbroideryColourChoiceOrder(picker, []);
    syncEmbroideryColourChoiceHiddenInput(picker);
    if (propertyName) {
      variantColourSetValues.set(propertyName, '');
    }
    syncEmbroideryColourSwatchAvailability(picker);
  }

  function syncEmbroideryTextColourPickerVisibility(input) {
    const block = input ? input.closest('[data-variant-embroidery-text-fields]') : null;
    if (!block) return;

    const picker = block.querySelector('[data-embroidery-text-colour-picker]');
    if (!picker) return;

    const propertyName = picker.getAttribute('data-property-name');

    if (embroideryTextBlockHasContent(block)) {
      picker.classList.remove('hidden');
      syncEmbroideryColourSwatchAvailability(picker);
    } else {
      picker.classList.add('hidden');
      clearEmbroideryColourSelection(picker, propertyName);
      clearEmbroideryTextColourError(block);
    }
  }

  function syncAllEmbroideryTextColourPickerVisibility() {
    document.querySelectorAll('[data-variant-embroidery-text-fields]').forEach(function (block) {
      syncEmbroideryTextColourPickerVisibility(
        block.querySelector('[data-embroidery-text-input]')
      );
    });
  }

  function validateEmbroideryTextColourPickers(priorFieldsValid) {
    const blocks = document.querySelectorAll('[data-variant-embroidery-text-fields]');
    if (!blocks.length) return true;

    let isValid = true;
    let firstInvalid = null;

    blocks.forEach(function (block) {
      if (block.classList.contains('hidden')) return;

      const picker = block.querySelector(
        '[data-embroidery-text-colour-picker][data-has-colours="true"]'
      );
      if (!picker) return;

      if (!embroideryTextBlockHasContent(block)) {
        clearEmbroideryTextColourError(block);
        return;
      }

      picker.classList.remove('hidden');
      const hasColour = Boolean(readEmbroideryColourChoiceSavedValue(picker));

      if (!hasColour) {
        showEmbroideryTextColourError(block);
        if (!firstInvalid) {
          firstInvalid = picker.querySelector('[data-embroidery-text-colour-checkbox]');
        }
        isValid = false;
      } else {
        clearEmbroideryTextColourError(block);
      }
    });

    if (firstInvalid && priorFieldsValid) firstInvalid.focus();
    return isValid;
  }

  function handleEmbroideryTextColourCheckboxChange(checkbox) {
    const picker = checkbox.closest('[data-embroidery-text-colour-picker]');
    if (!picker) return;

    let order = getEmbroideryColourChoiceOrder(picker);
    const colourName = checkbox.value;

    if (checkbox.checked) {
      if (order.indexOf(colourName) === -1) {
        if (order.length >= EMBROIDERY_COLOUR_CHOICE_MAX) {
          checkbox.checked = false;
          return;
        }
        order.push(colourName);
      }
    } else {
      order = order.filter(function (name) {
        return name !== colourName;
      });
    }

    setEmbroideryColourChoiceOrder(picker, order);
    syncEmbroideryColourChoiceHiddenInput(picker);

    const propertyName = picker.getAttribute('data-property-name');
    if (propertyName) {
      variantColourSetValues.set(propertyName, readEmbroideryColourChoiceSavedValue(picker));
    }

    const block = picker.closest('[data-variant-embroidery-text-fields]');
    if (block) {
      picker.classList.remove('hidden');
      clearEmbroideryTextColourError(block);
    }
    syncEmbroideryColourSwatchAvailability(picker);
  }

  const earTextFieldConfig = [
    { selector: 'input[name="properties[1st Ear Text]"]' },
    { selector: 'input[name="properties[2nd Ear Text]"]' },
  ];

  function getFirstEarTextInput() {
    return document.querySelector('input[name="properties[1st Ear Text]"]');
  }

  function getSecondEarTextInput() {
    return document.querySelector('input[name="properties[2nd Ear Text]"]');
  }

  function isEarTextFieldWrapperVisible(wrapper) {
    return Boolean(wrapper && !wrapper.classList.contains('hidden'));
  }

  function isEarTextInputActive(input) {
    if (!input || input.disabled) return false;
    return isEarTextFieldWrapperVisible(input.closest('.ear-text-field'));
  }

  function syncEarTextFieldInputState() {
    document.querySelectorAll('[data-ear-text-field]').forEach(function (wrapper) {
      const input = wrapper.querySelector('[data-ear-text-input]');
      if (!input) return;
      const visible = isEarTextFieldWrapperVisible(wrapper);
      input.disabled = !visible;
      if (!visible) {
        clearEarFieldError(input);
      }
    });
  }

  function hasAnyVisibleEarTextField() {
    return Array.prototype.some.call(
      document.querySelectorAll('[data-ear-text-field]'),
      isEarTextFieldWrapperVisible
    );
  }

  function updateSharedEarColourAndFontRevealState() {
    if (sharedEarColourAndFontRevealed) return;
    earTextFieldConfig.forEach(function (field) {
      const input = document.querySelector(field.selector);
      if (isEarTextInputActive(input) && input.value.trim()) {
        sharedEarColourAndFontRevealed = true;
      }
    });
  }

  function isSharedEarColourAndFontVisible() {
    updateSharedEarColourAndFontRevealState();
    if (!hasAnyVisibleEarTextField()) return false;
    return sharedEarColourAndFontRevealed;
  }

  function getEarTextSharedRoot() {
    return document.querySelector('[data-variant-ear-text-shared]');
  }

  function getSharedEarColourPicker() {
    const shared = getEarTextSharedRoot();
    if (!shared) return null;
    return shared.querySelector('[data-ear-colour-picker][data-has-colours="true"]');
  }

  function saveEarValues() {
    const first = document.querySelector(
      'input[name="properties[1st Ear Text]"]'
    );

    const second = document.querySelector(
      'input[name="properties[2nd Ear Text]"]'
    );

    if (first) {
      firstEarText = first.value;
    }

    if (second) {
      secondEarText = second.value;
    }

    saveEarColourValues();
  }

  function saveEarColourValues() {
    const checked = document.querySelector(
      'input[name="' + EAR_TEXT_COLOUR_PROPERTY + '"]:checked'
    );
    earTextColour = checked ? checked.value : '';
  }

  function clearEarColourSelection() {
    document
      .querySelectorAll('input[name="' + EAR_TEXT_COLOUR_PROPERTY + '"]')
      .forEach(function (radio) {
        radio.checked = false;
      });
    earTextColour = '';
  }

  function syncSharedEarColourAndFontVisibility() {
    const shared = getEarTextSharedRoot();
    const visible = isSharedEarColourAndFontVisible();
    const picker = getSharedEarColourPicker();
    const fontPicker = shared
      ? shared.querySelector('[data-font-selection-picker][data-has-fonts="true"]')
      : document.querySelector('[data-font-selection-picker][data-has-fonts="true"]');

    if (picker) {
      if (visible) {
        picker.classList.remove('hidden');
      } else {
        picker.classList.add('hidden');
        clearEarColourSelection();
        clearSharedEarColourError();
      }
    }

    if (fontPicker && shared) {
      if (visible) {
        fontPicker.classList.remove('hidden');
      } else {
        fontPicker.classList.add('hidden');
        clearFontSelectionError(fontPicker);
      }
    }
  }

  function syncAllEarColourPickerVisibility() {
    syncSharedEarColourAndFontVisibility();
  }

  function restoreEarColourValues() {
    if (!earTextColour) {
      syncAllEarColourPickerVisibility();
      return;
    }

    document
      .querySelectorAll('input[name="' + EAR_TEXT_COLOUR_PROPERTY + '"]')
      .forEach(function (radio) {
        radio.checked = radio.value === earTextColour;
      });

    syncAllEarColourPickerVisibility();
  }

  function restoreEarValues() {
    const first = document.querySelector(
      'input[name="properties[1st Ear Text]"]'
    );

    const second = document.querySelector(
      'input[name="properties[2nd Ear Text]"]'
    );

    restoreTextInputValue(first, firstEarText);
    restoreTextInputValue(second, secondEarText);

    restoreEarColourValues();
  }

  function showEarFieldError(input) {
    const wrapper = input.closest('.ear-text-field');
    if (!wrapper) return;

    wrapper.classList.add('ear-text-field--invalid');
    input.setAttribute('aria-invalid', 'true');

    const errorEl = wrapper.querySelector('.ear-text-field__error');
    if (errorEl) {
      input.setAttribute('aria-describedby', errorEl.id);
      errorEl.classList.remove('hidden');
    }
  }

  function clearEarFieldError(input) {
    const wrapper = input.closest('.ear-text-field');
    if (!wrapper) return;

    wrapper.classList.remove('ear-text-field--invalid');
    input.setAttribute('aria-invalid', 'false');
    input.removeAttribute('aria-describedby');

    const errorEl = wrapper.querySelector('.ear-text-field__error');
    if (errorEl) errorEl.classList.add('hidden');
  }

  function showSharedEarColourError() {
    const picker = getSharedEarColourPicker();
    if (!picker || picker.classList.contains('hidden')) return;

    picker.classList.add('ear-text-field__colour--invalid');

    const errorEl = picker.querySelector('.ear-text-field__colour-error');
    if (errorEl) {
      errorEl.classList.remove('hidden');
    }

    const firstRadio = picker.querySelector('input[type="radio"]');
    if (firstRadio) {
      firstRadio.setAttribute('aria-invalid', 'true');
      if (errorEl) {
        firstRadio.setAttribute('aria-describedby', errorEl.id);
      }
    }
  }

  function clearSharedEarColourError() {
    const picker = getSharedEarColourPicker();
    if (!picker) return;

    picker.classList.remove('ear-text-field__colour--invalid');

    const errorEl = picker.querySelector('.ear-text-field__colour-error');
    if (errorEl) {
      errorEl.classList.add('hidden');
    }

    picker.querySelectorAll('input[type="radio"]').forEach(function (radio) {
      radio.setAttribute('aria-invalid', 'false');
      radio.removeAttribute('aria-describedby');
    });
  }

  function validateEarTextFields() {
    let isValid = true;
    let firstInvalidElement = null;

    earTextFieldConfig.forEach(function (field) {
      const input = document.querySelector(field.selector);
      if (!input || !isEarTextInputActive(input)) {
        if (input) clearEarFieldError(input);
        return;
      }

      if (!input.value.trim()) {
        showEarFieldError(input);
        if (!firstInvalidElement) firstInvalidElement = input;
        isValid = false;
      } else {
        clearEarFieldError(input);
      }
    });

    syncSharedEarColourAndFontVisibility();

    const colourPicker = getSharedEarColourPicker();
    if (colourPicker && !colourPicker.classList.contains('hidden')) {
      const selected = document.querySelector(
        'input[name="' + EAR_TEXT_COLOUR_PROPERTY + '"]:checked'
      );

      if (!selected) {
        showSharedEarColourError();
        if (!firstInvalidElement) {
          firstInvalidElement = colourPicker.querySelector('input[type="radio"]');
        }
        isValid = false;
      } else {
        clearSharedEarColourError();
      }
    }

    if (firstInvalidElement) firstInvalidElement.focus();
    return isValid;
  }

  function showFontSelectionError(picker) {
    if (!picker) return;

    picker.classList.add('font-selection--invalid');

    const errorEl = picker.querySelector('.font-selection__error');
    if (errorEl) {
      errorEl.classList.remove('hidden');
    }

    const firstRadio = picker.querySelector('input[type="radio"]');
    if (firstRadio) {
      firstRadio.setAttribute('aria-invalid', 'true');
      if (errorEl) {
        firstRadio.setAttribute('aria-describedby', errorEl.id);
      }
    }
  }

  function clearFontSelectionError(picker) {
    if (!picker) return;

    picker.classList.remove('font-selection--invalid');

    const errorEl = picker.querySelector('.font-selection__error');
    if (errorEl) {
      errorEl.classList.add('hidden');
    }

    picker.querySelectorAll('input[type="radio"]').forEach(function (radio) {
      radio.setAttribute('aria-invalid', 'false');
      radio.removeAttribute('aria-describedby');
    });
  }

  function validateFontSelection(earFieldsValid) {
    const picker = document.querySelector(
      '[data-font-selection-picker][data-has-fonts="true"]'
    );
    if (!picker || picker.classList.contains('hidden')) return true;

    const selected = document.querySelector(
      'input[name="properties[Font]"]:checked'
    );

    if (!selected) {
      showFontSelectionError(picker);
      if (earFieldsValid) {
        const firstRadio = picker.querySelector('input[type="radio"]');
        if (firstRadio) firstRadio.focus();
      }
      return false;
    }

    clearFontSelectionError(picker);
    return true;
  }

  function showDesignSelectionError(picker) {
    if (!picker) return;

    picker.classList.add('design-selection--invalid');

    const errorEl = picker.querySelector('.design-selection__error');
    if (errorEl) {
      errorEl.classList.remove('hidden');
    }

    const firstRadio = picker.querySelector('input[type="radio"]');
    if (firstRadio) {
      firstRadio.setAttribute('aria-invalid', 'true');
      if (errorEl) {
        firstRadio.setAttribute('aria-describedby', errorEl.id);
      }
    }
  }

  function clearDesignSelectionError(picker) {
    if (!picker) return;

    picker.classList.remove('design-selection--invalid');

    const errorEl = picker.querySelector('.design-selection__error');
    if (errorEl) {
      errorEl.classList.add('hidden');
    }

    picker.querySelectorAll('input[type="radio"]').forEach(function (radio) {
      radio.setAttribute('aria-invalid', 'false');
      radio.removeAttribute('aria-describedby');
    });
  }

  let productFormToastTimeout = null;

  function showProductFormToast(message) {
    const toastId = 'ProductCustomizationToast-{{ section.id }}';
    let toast = document.getElementById(toastId);
    if (!toast) {
      toast = document.createElement('div');
      toast.id = toastId;
      toast.className = 'product-customization-toast';
      toast.setAttribute('role', 'alert');
      document.body.appendChild(toast);
    }
    toast.textContent = message;
    toast.classList.add('product-customization-toast--visible');
    if (productFormToastTimeout) clearTimeout(productFormToastTimeout);
    productFormToastTimeout = setTimeout(function () {
      toast.classList.remove('product-customization-toast--visible');
    }, 4000);
  }

  function validateDesignSelection(priorFieldsValid) {
    const picker = document.querySelector(
      '[data-design-selection-picker][data-has-designs="true"]:not(.hidden)'
    );
    if (!picker) return true;

    const selected = picker.querySelector(
      'input[name="properties[Design]"]:enabled:checked'
    );

    if (!selected) {
      showDesignSelectionError(picker);
      showProductFormToast('Please choose a design');
      if (priorFieldsValid) {
        picker.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      return false;
    }

    clearDesignSelectionError(picker);
    return true;
  }

  const productFormElement = document.getElementById(
    'product-form-{{ section.id }}'
  );

  if (productFormElement) {
    productFormElement.addEventListener(
      'submit',
      function (event) {
        const earFieldsValid = validateEarTextFields();
        const fontSelectionValid = validateFontSelection(earFieldsValid);
        const designSelectionValid = validateDesignSelection(
          earFieldsValid && fontSelectionValid
        );
        const embroideryColourValid = validateEmbroideryTextColourPickers(
          earFieldsValid && fontSelectionValid && designSelectionValid
        );
        if (
          !earFieldsValid ||
          !fontSelectionValid ||
          !designSelectionValid ||
          !embroideryColourValid
        ) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      },
      true
    );
  }

  function handleEmbroideryTextInput(event) {
    if (!event.target.matches('[data-embroidery-text-input]')) return;
    syncEmbroideryTextColourPickerVisibility(event.target);
  }

  // Save values whenever customer types (section root catches fields inside and outside variant-selects)
  const customizationInputRoot = mainProductRoot || document;
  customizationInputRoot.addEventListener('input', function (event) {

    if (
      event.target.matches(
        'input[name="properties[1st Ear Text]"]'
      )
    ) {
      firstEarText = event.target.value;
      syncSharedEarColourAndFontVisibility();
      if (event.target.value.trim()) {
        clearEarFieldError(event.target);
      }
    }

    if (
      event.target.matches(
        'input[name="properties[2nd Ear Text]"]'
      )
    ) {
      secondEarText = event.target.value;
      syncSharedEarColourAndFontVisibility();
      if (event.target.value.trim()) {
        clearEarFieldError(event.target);
      }
    }

    if (event.target.matches('[data-line-item-property]')) {
      const key = event.target.getAttribute('data-line-item-property');
      rememberLineItemPropertyValue(key, event.target.value, true);
    }

    handleEmbroideryTextInput(event);

  });

  document.addEventListener('change', function (event) {
    if (event.target.matches('input[name="' + EAR_TEXT_COLOUR_PROPERTY + '"]')) {
      earTextColour = event.target.checked ? event.target.value : earTextColour;
      if (event.target.checked) {
        clearSharedEarColourError();
      }
    }

    if (event.target.matches('input[name="properties[Font]"]')) {
      const picker = document.querySelector(
        '[data-font-selection-picker][data-has-fonts="true"]'
      );
      if (picker && event.target.checked) {
        clearFontSelectionError(picker);
      }
    }

    if (event.target.matches('input[name="properties[Design]"]')) {
      const picker = document.querySelector(
        '[data-design-selection-picker][data-has-designs="true"]'
      );
      if (picker && event.target.checked) {
        clearDesignSelectionError(picker);
      }
    }

    const colourSetPicker = event.target.closest('[data-variant-colour-set-picker]');
    if (
      colourSetPicker &&
      event.target.matches('input[type="radio"]') &&
      event.target.checked
    ) {
      const propertyName = colourSetPicker.getAttribute('data-property-name');
      if (propertyName) {
        variantColourSetValues.set(propertyName, event.target.value);
      }
      clearVariantColourSetError(colourSetPicker);
    }

    if (event.target.matches('[data-embroidery-text-colour-checkbox]')) {
      handleEmbroideryTextColourCheckboxChange(event.target);
    }
  });


  function isProductVariantOptionControl(target) {
    if (!target) return false;
    if (target.matches('input[type="text"], textarea')) return false;
    if (target.tagName === 'SELECT') return true;
    if (target.tagName === 'INPUT' && target.type === 'radio') {
      return Boolean(target.dataset.optionValueId);
    }
    return false;
  }

  function saveCustomizationStateBeforeVariantUpdate() {
    saveEarValues();
    saveLineItemPropertyFields();
    saveVariantColourSetValues();
  }

  // Save before Dawn replaces variant-selects (real variant options only)
  document.addEventListener('change', function (event) {
    const variantRoot =
      event.target.closest('variant-radios') || event.target.closest('variant-selects');
    if (!variantRoot || !isProductVariantOptionControl(event.target)) return;
    saveCustomizationStateBeforeVariantUpdate();
  });

  syncEarTextFieldInputState();
  syncAllEarColourPickerVisibility();
  syncAllEmbroideryTextColourPickerVisibility();
  document
    .querySelectorAll('[data-embroidery-text-colour-picker]')
    .forEach(function (picker) {
      syncEmbroideryColourSwatchAvailability(picker);
    });

  function runCustomizationDomRestore() {
    restoreEarValues();
    restoreLineItemPropertyFields();
    restoreVariantColourSetValues();
    syncEarTextFieldInputState();
    syncAllEarColourPickerVisibility();
    syncAllEmbroideryTextColourPickerVisibility();
  }

  if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
    subscribe(PUB_SUB_EVENTS.variantChange, function (event) {
      if (!event?.data || String(event.data.sectionId) !== String(sectionId)) return;
      runCustomizationDomRestore();
    });
  }

});
</script>
<script>
  document.querySelectorAll('.custom-accordion').forEach(accordion => {

  const headers = accordion.querySelectorAll(
    '.custom-accordion-header'
  );

  headers.forEach(header => {

    header.addEventListener('click', () => {

      const currentItem =
        header.closest('.custom-accordion-item');

      const currentContent =
        currentItem.querySelector(
          '.custom-accordion-content'
        );

      const isOpen =
        currentItem.classList.contains('active');

      // Close all other items
      accordion
        .querySelectorAll('.custom-accordion-item')
        .forEach(item => {

          if (item !== currentItem) {

            item.classList.remove('active');

            const content =
              item.querySelector(
                '.custom-accordion-content'
              );

            content.style.height = '0px';
          }

        });

      // Toggle current item
      if (isOpen) {

        currentItem.classList.remove('active');
        currentContent.style.height = '0px';

      } else {

        currentItem.classList.add('active');

        currentContent.style.height =
          currentContent.scrollHeight + 'px';

      }

    });

  });

});
</script>
