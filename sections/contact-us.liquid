{{ 'section-contact-us.css' | asset_url | stylesheet_tag }}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  class="contact-us color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  id="ContactUs-{{ section.id }}"
>
  <div class="page-width contact-us__page">
    <div class="contact-us__inner">
      <header class="contact-us__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h1 class="contact-us__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading | escape }}
          </h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="contact-us__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>

      <div
        class="contact-us__card contact-us__details-card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {%- if section.settings.details_heading != blank -%}
          <h2 class="contact-us__card-title">{{ section.settings.details_heading | escape }}</h2>
        {%- endif -%}

        <ul class="contact-us__details-list" role="list">
          {%- if section.settings.contact_email != blank -%}
            <li class="contact-us__detail">
              <span class="contact-us__icon-wrap" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              <div>
                <span class="contact-us__detail-label">{{ section.settings.email_label | escape }}</span>
                <p class="contact-us__detail-value">
                  <a href="mailto:{{ section.settings.contact_email | strip }}">{{ section.settings.contact_email | escape }}</a>
                </p>
              </div>
            </li>
          {%- endif -%}

          {%- if section.settings.contact_phone != blank -%}
            {%- liquid
              assign phone_href = section.settings.contact_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' | replace: '+', ''
              assign phone_digits = phone_href | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
              assign phone_is_dialable = false
              if phone_digits == blank and phone_href.size >= 8
                assign phone_is_dialable = true
              endif
            -%}
            <li class="contact-us__detail">
              <span class="contact-us__icon-wrap" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <div>
                <span class="contact-us__detail-label">{{ section.settings.phone_label | escape }}</span>
                <p class="contact-us__detail-value">
                  {%- if phone_is_dialable -%}
                    <a href="tel:{{ phone_href }}">{{ section.settings.contact_phone | escape }}</a>
                  {%- else -%}
                    {{ section.settings.contact_phone | escape }}
                  {%- endif -%}
                </p>
              </div>
            </li>
          {%- endif -%}

          {%- if section.settings.contact_address != blank -%}
            <li class="contact-us__detail">
              <span class="contact-us__icon-wrap" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <div>
                <span class="contact-us__detail-label">{{ section.settings.address_label | escape }}</span>
                <p class="contact-us__detail-value">{{ section.settings.contact_address | escape | newline_to_br }}</p>
              </div>
            </li>
          {%- endif -%}
        </ul>

        {%- if section.settings.contact_hours != blank -%}
          <div class="contact-us__hours">
            <span class="contact-us__detail-label">{{ section.settings.hours_label | escape }}</span>
            <p class="contact-us__detail-value">{{ section.settings.contact_hours | escape | newline_to_br }}</p>
          </div>
        {%- endif -%}
      </div>

      <div
        class="contact-us__card contact-us__form-card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {%- if section.settings.form_heading != blank -%}
          <h2 class="contact-us__card-title">{{ section.settings.form_heading | escape }}</h2>
        {%- else -%}
          <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
        {%- endif -%}

        {%- liquid
          assign contact_form_class = 'contact isolate'
          if settings.animations_reveal_on_scroll
            assign contact_form_class = 'contact isolate scroll-trigger animate--slide-in'
          endif
        -%}

        {%- form 'contact', id: 'ContactUsForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <h3 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h3>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h3 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactUsForm-email" class="link">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </a>
              </li>
            </ul>
          {%- endif -%}

          <div class="contact__fields">
            <div class="field">
              <input
                class="field__input"
                autocomplete="name"
                type="text"
                id="ContactUsForm-name"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'templates.contact.form.name' | t }}"
              >
              <label class="field__label" for="ContactUsForm-name">{{ 'templates.contact.form.name' | t }}</label>
            </div>
            <div class="field field--with-error">
              <input
                autocomplete="email"
                type="email"
                id="ContactUsForm-email"
                class="field__input"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactUsForm-email-error"
                {% endif %}
                placeholder="{{ 'templates.contact.form.email' | t }}"
              >
              <label class="field__label" for="ContactUsForm-email">
                {{- 'templates.contact.form.email' | t }}
                <span aria-hidden="true">*</span></label
              >
              {%- if form.errors contains 'email' -%}
                <small class="contact__field-error" id="ContactUsForm-email-error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="form__message">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </span>
                </small>
              {%- endif -%}
            </div>
          </div>
          <div class="field">
            <input
              type="tel"
              id="ContactUsForm-phone"
              class="field__input"
              autocomplete="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              pattern="[0-9\-]*"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="{{ 'templates.contact.form.phone' | t }}"
            >
            <label class="field__label" for="ContactUsForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
          </div>
          <div class="field">
            <textarea
              rows="8"
              id="ContactUsForm-body"
              class="text-area field__input"
              name="contact[{{ 'templates.contact.form.comment' | t }}]"
              placeholder="{{ 'templates.contact.form.comment' | t }}"
            >
              {{- form.body -}}
            </textarea>
            <label class="form__label field__label" for="ContactUsForm-body">
              {{- 'templates.contact.form.comment' | t -}}
            </label>
          </div>
          <div class="contact__button">
            <button type="submit" class="button">
              {{ 'templates.contact.form.send' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact us",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Store contact details"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email address",
      "default": "yourgift@myteddy.com.au"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone number",
      "default": "Add your phone number here",
      "info": "Shown on the page and linked for tap-to-call on mobile."
    },
    {
      "type": "textarea",
      "id": "contact_address",
      "label": "Business address",
      "default": "Add your street address\nCity, State, Postcode",
      "info": "Use separate lines for street, city, and postcode."
    },
    {
      "type": "textarea",
      "id": "contact_hours",
      "label": "Opening hours (optional)",
      "info": "Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Page header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact us"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Introduction",
      "default": "We would love to hear from you — reach out anytime with questions about your order or our bears."
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Contact details card heading",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "Address label",
      "default": "Address"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form card heading",
      "default": "Send us a message"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Contact us"
    }
  ]
}
{% endschema %}
