    "testimonials_yWbnqU": {
      "type": "testimonials",
      "blocks": {
        "testimonial_NqiWct": {
          "type": "testimonial",
          "settings": {
            "text": "Absolutely adorable! The bunny I purchased arrived in two days! It is so soft and will be a forever toy. My Teddy were so easy to deal with and responded to my queries straight away. Thank you! I will definitely be back!",
            "name": "Frankie",
            "date": "March 2021"
          }
        },
        "testimonial_YrJ9LE": {
          "type": "testimonial",
          "settings": {
            "text": "Beautiful and quick contact. It arrived so quick during the Xmas week which was amazing. Thank you",
            "name": "Peta",
            "date": "December 2020"
          }
        },
        "testimonial_4rXBTJ": {
          "type": "testimonial",
          "settings": {
            "text": "Thank you Chris! Amazing service, such speedy delivery and the Teddy is just perfect! Highly recommend",
            "name": "Rita",
            "date": "December 2020"
          }
        },
        "testimonial_DDa9PV": {
          "type": "testimonial",
          "settings": {
            "text": "I want to thank everyone at My Teddy for the fast service and delivery. My granddaughter ended up in hospital and I ordered a personalised Charlie Cream 47cm Gund bear. He is beautiful, and you made his top look exactly as I envisaged it. Amazing job, amazing speed. Thank you! I will be recommending you to everyone.",
            "name": "Ana",
            "date": "September 2020"
          }
        },
        "testimonial_Yz9VRn": {
          "type": "testimonial",
          "settings": {
            "text": "Extremely happy with the service received from My Teddy. I have ordered 4 times through this company and i have to say I am most impressed with the latest order. I ordered a personalised easter bunny for my baby's 1st easter on Monday 06/04/2020. I had received the proof to approve on Tuedsay 07/04/2020 at 8:34 QLD time, to which I approved. The order was sent on Wednesday 08/04/2020 and received Today 09/04/2020 in the AM. I honestly did not think I would have received this before easter. I am extremely thankful that the team was able to put this through so promptly. I will definitely be back time and time again!!",
            "name": "Bree ",
            "date": "March 2020"
          }
        },
        "testimonial_fBphbd": {
          "type": "testimonial",
          "settings": {
            "text": "Who ever would have thought there was a custom teddy shop. Wow.!!!! Best idea for a gift. Super friendly and fast delivery.",
            "name": "Brent ",
            "date": "Feb  2021"
          }
        },
        "testimonial_tGU7Je": {
          "type": "testimonial",
          "settings": {
            "text": "I am amazed by the excellent service I received from the My Teddy team. Toni was amazing and made sure that I received my teddy in time for when I needed it. It also arrived earlier than I expected. The whole process was extremely easy and I am extremely happy with my teddy and the quality of it. 100% would recommend them to everyone!!",
            "name": "Vanitha ",
            "date": "Aug 2019"
          }
        }
      },
